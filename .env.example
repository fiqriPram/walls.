# Get this from https://neon.tech after creating a free project
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/walls?sslmode=require

# Better Auth (generate a secret: openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Optional: Wallhaven API key (free at wallhaven.cc/settings/account).
# Without it the Wallhaven source works fine for SFW, with a higher rate limit if set.
# WALLHAVEN_API_KEY=
